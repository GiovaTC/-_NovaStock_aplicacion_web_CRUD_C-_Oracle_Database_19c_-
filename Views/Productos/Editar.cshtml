@model Producto
@{
    ViewData["Title"] = "Editar producto";
}
<div class="form-wrap">
    <div class="panel form-panel">
        <div class="panel-heading">
            <div><h3>Editar producto #@Model.Id</h3><p>Modifica los datos y guarda los cambios.</p></div>
            <span class="form-symbol">✎</span>
        </div>
        <form asp-action="Editar" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_FormularioProducto" model="Model" />
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>  