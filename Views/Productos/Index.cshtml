@model IEnumerable<Producto>
@{
    ViewData["Title"] = "Productos";
    var lista = Model.ToList();
    var unidades = lista.Sum(p => p.Stock);
    var valorInventario = lista.Sum(p => p.Precio * p.Stock);
}
<div class = "welcome-row">
    <div>
        <h2>INVENTARIO de productos</h2>
        <p>Administra, consulta y actualiza tus productos desde un solo lugar.</p>
    </div>
    <a class="btn btn-primary btn-lg" asp-action="Crear">
        <span class="plus">+</span> NUEVO producto
    </a>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon purple">▦</div>
        <div><span>PRODUCTOS registrados</span><strong>@ViewBag.TotalProductos</strong><small>REGISTROS en oracle</small></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon blue">▤</div>
        <div><span>UNIDADES en stock</span><strong>@unidades</strong><small>Existencias actuales</small></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">$</div>
        <div><span>UNIDADES en stock</span><strong>@unidades</strong><small>EXISTENCIAS actuales</small></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon green">$</div>
        <div><span>VALOR del INVENTARIO</span>
            <strong>@valorInventario.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CO"))</strong>
            <small>PRECIO * unidades</small>
        </div>
    </div>
</div>
