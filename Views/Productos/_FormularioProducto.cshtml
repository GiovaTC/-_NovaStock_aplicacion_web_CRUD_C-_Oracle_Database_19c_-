@model Producto
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-4 form-fields">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Teclado inalámbrico" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select">
            <option>General</option><option>Tecnología</option><option>Accesorios</option>
            <option>Oficina</option><option>Hogar</option><option>Deportes</option>
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"
                  placeholder="Describe brevemente el producto..."></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Precio" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="Precio" class="form-control" type="number" step="0.01"
                   min="0.01" placeholder="0.00" />
        </div>
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
</div>  