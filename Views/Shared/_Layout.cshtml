<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NovaStock</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class= "brand" asp-controller="Productos" asp-action="Index">
                <span class="= "brand-mark">N</span>
                <span>NovaStock<small>GESTION DE INVENTARIO</small></span>
            </a>
            <div class="menu-label">MENU PRINCIPAL</div>
            <a class="nav-link active" asp-controller="Productos" asp-action="Index">
                <span>▦</span> Productos
            </a>
            <div class="sidebar-note">
                <span class= "status-dot"></span> Conectado a ORACLE
                <small>Base de datos empresarial!</small>
            </div>
        </aside>
        <main class="main-area">
            <header class="topbar">
                <div>
                    <div class="eyebrow">PANEL DE administracion</div>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="user-chip">
                    <span class="avatar">A</span>
                    <span>Administrador<small>USUARIO local</small></span>
                </div>
            </header>
            <section class="content-area">
                @if (TempData["Mensaje"] is string mensaje)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        @mensaje
                        <button type="button" class="btn-close" data-bs-dismiss="alert" 
                        aria-label="CERRAR"></button>
                    </div>
                }
                @RenderBody()   
            </section>
            <footer>NovaStock <span>•</span> APLICACION demostrativa ASP.NET core + Oracle 19C</footer>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
