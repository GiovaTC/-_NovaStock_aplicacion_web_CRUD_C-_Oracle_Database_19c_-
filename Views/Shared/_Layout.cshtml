<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NovaStock</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a asp-controller="Productos"
               asp-action="Index"
               class="brand">
                <span class="brand-mark">N</span>
                <span>
                    NovaStock
                    <small>GESTIÓN DE INVENTARIO</small>
                </span>
            </a>

            <p class="menu-label">MENÚ PRINCIPAL</p>

            <nav class="nav flex-column">
                <a asp-controller="Productos"
                   asp-action="Index"
                   class="nav-link active">
                    <span>▦</span> Productos
                </a>
            </nav>

            <div class="sidebar-note">
                <span class="status-dot"></span>
                Conectado a Oracle
                <small>Base de datos empresarial</small>
            </div>
        </aside>

        <main class="main-area">
            <header class="topbar">
                <div>
                    <p class="eyebrow">PANEL DE ADMINISTRACIÓN</p>
                    <h1>@ViewData["Title"]</h1>
                </div>

                <span class="user-chip">Administrador</span>
            </header>

            <section class="content-area">
                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Mensaje"]
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Cerrar"></button>
                    </div>
                }

                @RenderBody()
            </section>

            <footer class="app-footer">
                NovaStock · ASP.NET Core MVC · Oracle Database 19c
            </footer>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 
